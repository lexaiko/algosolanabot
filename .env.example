# ============================================================================
# AlgoSolanaBot — contoh konfigurasi
# Salin ke .env lalu isi. Setiap nilai numerik divalidasi saat startup:
#   - knob KRITIS (bertanda [KRITIS]) yang diisi TIDAK VALID → bot MENOLAK
#     start (process.exit 1). Jangan asal isi.
#   - knob biasa yang tidak valid → fallback ke default + warning.
# Default di bawah ini SELARAS dengan default kode (src/config.ts, 2026-09-29).
# ============================================================================

# --- Telegram (WAJIB) ---
# Token dari @BotFather.
TELEGRAM_BOT_TOKEN=
# [KRITIS] ID numerik kamu (dari @userinfobot) — BUKAN username, BUKAN placeholder.
# Kosong / bukan angka → bot jalan TANPA admin: autonomous buy DINONAKTIFKAN
# fail-closed, alert masuk outbox. Isi dengan angka, mis. 123456789.
TELEGRAM_ADMIN_ID=

# --- RPC ---
HELIUS_API_KEY=
# Pisahkan beberapa key dengan koma untuk rotasi otomatis: key1,key2,key3

# --- Mode ---
PAPER_TRADING=true   # true = simulasi (default aman). false = LIVE, real SOL.

# --- Saldo & sizing ---
# [KRITIS] Saldo awal paper wallet (SOL). Tombol "Reset Saldo" di Telegram
# me-reset ke nilai ini.
INITIAL_PAPER_BALANCE_SOL=1.0
DEFAULT_BUY_AMOUNT_SOL=0.05
SLIPPAGE_PCT=2.5

# --- Exit engine (aktual: 100% single-exit via dynamic ratchet, TANPA partial) ---
# Tier ratchet (peak gain → floor terkunci, NET of fees): +22→+3.5% | +45→+25% |
# +80→+50% | +150→+100%. Trailing adaptif 10–20% dari peak.
# [KRITIS] Hard stop-loss (drawdown maksimum per posisi).
STOP_LOSS_PCT=9.5
# Berikut ini dipakai modul mirror/backtest & display Telegram (bukan partial-close):
TAKE_PROFIT_PCT=45.0
TRAILING_STOP_PCT=12.0

# --- Proteksi portofolio ---
CIRCUIT_BREAKER_ENABLED=true
# [KRITIS] Berapa SL harian sebelum bot berhenti beli.
CIRCUIT_BREAKER_MAX_DAILY_LOSSES=3
CIRCUIT_BREAKER_COOLDOWN_HOURS=1
MAX_PRICE_DRIFT_PCT=6.0
# [KRITIS] Floor likuiditas pool (USD).
MIN_LIQUIDITY_USD=30000
MIN_VOLUME_24H_USD=150000
MIN_MARKET_CAP_USD=15000
MAX_OPEN_POSITIONS=15
# [KRITIS] Time-stop maksimum per posisi (jam). Zombie reaper mendaur ulang
# posisi stagnan sebelum batas ini.
MAX_HOLD_TIME_HOURS=24
MAX_5M_PRICE_CHANGE_PCT=50.0
NOTIFY_ON_REJECT=true

# --- Survival Phase Funnel (anti rug / anti detik-0) ---
MIN_TOKEN_AGE_SEC=180
MAX_TOKEN_AGE_HOURS=24
BONDING_CURVE_MIN_PCT=25.0
BONDING_CURVE_MAX_PCT=85.0
MAX_DEV_HOLDING_PCT=5.0
MIN_UNIQUE_HOLDERS=45

# --- Anti-rug ---
MIN_RUGCHECK_SCORE=75
REQUIRE_MINT_REVOKED=true
REQUIRE_FREEZE_REVOKED=true
REQUIRE_LP_BURNED=true
MAX_TOP10_HOLDERS_PCT=50.0

# --- Interval ---
POSITION_CHECK_INTERVAL_SEC=2

# --- Jito MEV shield ---
JITO_MEV_ENABLED=true
JITO_TIP_LAMPORTS=100000
JITO_BLOCK_ENGINE_URL=https://amsterdam.mainnet.block-engine.jito.wtf

# --- Cabal / Sybil shield ---
CABAL_SHIELD_ENABLED=true
CABAL_MAX_TX_LOOKBACK=25

# --- Kelly sizing & flash-exit ---
KELLY_SIZING_ENABLED=true
# [KRITIS] Fraksi Kelly (0.01–1.0). 0.25 = quarter-Kelly.
KELLY_FRACTION=0.25
MAX_LIQUIDITY_DEPTH_PCT=1.5
# [KRITIS] Maksimum % ekuitas yang boleh ter-deploy (0.01–1.0).
MAX_PORTFOLIO_HEAT_PCT=0.50
# [KRITIS] Kill-switch ekuitas harian, realized (0.001–1.0). 0.08 = -8%.
DAILY_MAX_LOSS_PCT=0.08
FLASH_EXIT_ENABLED=true
# Dump 100% bila likuiditas drop ≥ nilai ini DAN di bawah $12k.
FLASH_EXIT_DROP_PCT=30.0

# --- Estimasi fee jaringan (SOL) ---
ESTIMATED_BUY_FEE_SOL=0.00035
ESTIMATED_SELL_FEE_SOL=0.00025

# --- Alpha / narrative ---
MAX_POSITIONS_PER_NARRATIVE=2
ROLLING_WINDOW_DAYS=7
VOLATILITY_ADAPTIVE_EXITS=true

# --- Dihapus 2026-09-29 (jangan pakai lagi) ---
# COPY_SELL_ENABLED, AUTO_WHALE_DISCOVERY, WHALE_* — whale-follow dicabut total.
# Variabel-variabel itu tidak dibaca kode lagi; mengisinya tidak berpengaruh.
