# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_admin_id_here

# Solana RPC & Data Providers (Helius)
HELIUS_API_KEY=your_helius_key_1,your_helius_key_2
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key_1

# Trading Settings
PAPER_TRADING=true
INITIAL_PAPER_BALANCE_SOL=10.0
DEFAULT_BUY_AMOUNT_SOL=0.10
VIP_BUY_AMOUNT_SOL=0.15
SLIPPAGE_PCT=2.5

# Risk Management & Multi-Tier Take-Profit
TAKE_PROFIT_PCT=42.0
STOP_LOSS_PCT=14.0
TRAILING_STOP_PCT=18.0

# Institutional Portfolio & Execution Controls
COPY_SELL_ENABLED=true
CIRCUIT_BREAKER_MAX_DAILY_LOSSES=999
CIRCUIT_BREAKER_COOLDOWN_HOURS=0
MAX_PRICE_DRIFT_PCT=6.0
MIN_LIQUIDITY_USD=6000.0
MIN_VOLUME_24H_USD=25000.0
MIN_MARKET_CAP_USD=15000.0
MAX_OPEN_POSITIONS=15
MAX_HOLD_TIME_HOURS=24
MAX_5M_PRICE_CHANGE_PCT=20.0
NOTIFY_ON_REJECT=true

# Autonomous Whale Scout & Screening
AUTO_WHALE_DISCOVERY=true
WHALE_DISCOVERY_INTERVAL_MIN=30
MAX_ACTIVE_WHALES=15
MIN_WHALE_BALANCE_SOL=1.5
MIN_WHALE_HOLDING_SEC=90
MIN_WHALE_HISTORY_TXS=10
MIN_WHALE_BUY_SOL=0.2
AUTO_PRUNE_INACTIVE_HOURS=168
MAX_CONSECUTIVE_LOSSES=2
MIN_WINRATE_PCT=50.0

# Anti-Rug Filters (RugCheck)
MIN_RUGCHECK_SCORE=75
REQUIRE_MINT_REVOKED=true
REQUIRE_FREEZE_REVOKED=true
REQUIRE_LP_BURNED=true
MAX_TOP10_HOLDERS_PCT=50.0

# Background Monitoring Intervals (seconds)
POSITION_CHECK_INTERVAL_SEC=10
WHALE_CHECK_INTERVAL_SEC=15
